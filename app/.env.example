# AgentMarket env. Copy to .env.local (gitignored) and fill in. Secrets are server-side only.

# --- Privy (embedded wallets) ---
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here
NEXT_PUBLIC_PRIVY_CLIENT_ID=        # optional, leave empty

# --- LLM (server-side only; never NEXT_PUBLIC) ---
OPENAI_API_KEY=sk-...               # or set ANTHROPIC_API_KEY to use Claude via the adapter

# --- Monad testnet ---
MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# --- Wallets (two distinct EOAs; C must != O for anti-self-feedback) ---
# OWNER (O): registers + owns agents; agents' payout address
OWNER_ADDRESS=0x...
OWNER_PRIVATE_KEY=0x...
# CLIENT (C): pays agents + writes giveFeedback
CLIENT_ADDRESS=0x...
CLIENT_PRIVATE_KEY=0x...

# Set after running scripts/register-agents.ts
AGENT_IDS=

# --- Web push (template/PWA; optional, unused by core demo) ---
# WEB_PUSH_EMAIL=user@example.com
# WEB_PUSH_PRIVATE_KEY=
# NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
